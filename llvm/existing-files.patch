+// A breakpoint that stops the program after the instruction at its address
+// (PIC16F1 silicon) has, when that instruction is a call, stopped it at the
+// start of another function, and it will not come back through the
+// breakpoint's address: it returns to the instruction after. Move the
+// breakpoint to where this new function returns to.
+// The address of the return instruction of the PIC16F1 function \a frame is
+// in, if it has exactly one and no other way out (a jump to another
+// function, or a computed one).
+lldb::addr_t ThreadPlanStepOut::FindOnlyReturnInstruction(StackFrame &frame) {
+  Target &target = GetTarget();
+  if (target.GetArchitecture().GetMachine() != llvm::Triple::pic16f1)
+    return LLDB_INVALID_ADDRESS;
+  SymbolContext sc = frame.GetSymbolContext(eSymbolContextFunction |
+                                            eSymbolContextSymbol);
+  AddressRange range;
+  if (!sc.GetAddressRange(eSymbolContextFunction | eSymbolContextSymbol, 0,
+                          false, range))
+    return LLDB_INVALID_ADDRESS;
+  const lldb::addr_t start = range.GetBaseAddress().GetLoadAddress(&target);
+  const size_t size = range.GetByteSize();
+  if (start == LLDB_INVALID_ADDRESS || size < 2 || size > 0x4000)
+    return LLDB_INVALID_ADDRESS;
+  std::vector<uint8_t> bytes(size);
+  Status error;
+  if (target.ReadMemory(range.GetBaseAddress(), bytes.data(), size, error) !=
+      size)
+    return LLDB_INVALID_ADDRESS;
+
+  const uint32_t first = start / 2, count = size / 2;
+  lldb::addr_t found = LLDB_INVALID_ADDRESS;
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint16_t word = (bytes[2 * i] | (bytes[2 * i + 1] << 8)) & 0x3FFF;
+    const bool is_return =
+        word == 0x0008 || word == 0x0009 || (word & 0x3F00) == 0x3400;
+    if (is_return) {
+      if (found != LLDB_INVALID_ADDRESS)
+        return LLDB_INVALID_ADDRESS;
+      found = start + 2 * i;
+      continue;
+    }
+    uint32_t target_word;
+    if ((word & 0x3800) == 0x2800) // GOTO, within the page
+      target_word = ((first + i) & ~0x7FFu) | (word & 0x7FF);
+    else if ((word & 0x3E00) == 0x3200) // BRA
+      target_word = first + i + 1 + (word & 0x1FF) - ((word & 0x100) ? 0x200 : 0);
+    else if (word == 0x000B || word == 0x000A || // BRW, CALLW
+             (word & 0x30FF) == 0x0082) // a byte operation that writes PCL
+      return LLDB_INVALID_ADDRESS;
+    else
+      continue;
+    if (target_word < first || target_word >= first + count)
+      return LLDB_INVALID_ADDRESS;
+  }
+  return found;
+}
