+/// On a target whose pointers are not addresses of the debugger's address
+/// space as they stand (PIC16F1: a data pointer is 16 bits and data memory
+/// is at an offset; a function pointer counts words), turn the value of a
+/// pointer variable into the address it points at.
+static addr_t PointerToAddress(ValueObject &valobj, addr_t value) {
+  if (value == LLDB_INVALID_ADDRESS)
+    return value;
+  ExecutionContext exe_ctx(valobj.GetExecutionContextRef());
+  Process *process = exe_ctx.GetProcessPtr();
+  if (!process || process->GetTarget().GetArchitecture().GetMachine() !=
+                      llvm::Triple::pic16f1)
+    return value;
+  if (valobj.GetCompilerType().IsFunctionPointerType())
+    return value * 2;
+  if (ABISP abi_sp = process->GetABI())
+    return abi_sp->FixDataAddress(value);
+  return value;
+}
