+// PIC16F1 data memory is banked: 80 general-purpose bytes in each bank, laid
+// end to end in the linear view that starts at 0x2000 in the data space
+// (0x800000 here). Code reaches a variable directly only after selecting
+// its bank, and the compiler selects once for all the bytes of a variable.
+// So a small input section must not cross from one bank into the next:
+// start it in the next bank instead. The compiler puts every variable in a
+// section of its own. "Small" is up to 16 bytes, which covers scalars and
+// small structures and wastes at most 15 bytes at a bank boundary; the
+// compiler (PIC16F1ExpandPseudo.cpp) uses the same limit.
+static uint64_t pic16f1KeepInBank(uint64_t dot, uint64_t size) {
+  const uint64_t base = 0x802000, end = 0x802FF0, bank = 80, small = 16;
+  if (dot < base || dot >= end || size <= 1 || size > small)
+    return dot;
+  uint64_t n = dot - base;
+  if (n / bank != (n + size - 1) / bank)
+    return base + (n / bank + 1) * bank;
+  return dot;
+}
