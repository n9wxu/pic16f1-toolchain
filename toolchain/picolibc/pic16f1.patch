diff --git a/libc/machine/pic16f1/meson.build b/libc/machine/pic16f1/meson.build
new file mode 100644
index 0000000..04d3c58
--- /dev/null
+++ b/libc/machine/pic16f1/meson.build
@@ -0,0 +1,18 @@
+# Microchip PIC16F1 (enhanced mid-range), LLVM toolchain.
+# setjmp/longjmp are not implemented yet; the library holds a placeholder.
+srcs_machine = [
+  'placeholder.c',
+]
+
+foreach params : targets
+  target = params['name']
+  target_dir = params['dir']
+  target_c_args = params['c_args']
+
+  set_variable('lib_machine' + target,
+	       static_library('machine' + target,
+			      srcs_machine,
+			      pic: use_pic,
+			      include_directories: inc,
+			      c_args: target_c_args + c_args + arg_fnobuiltin))
+endforeach
