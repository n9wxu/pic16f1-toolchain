#!/bin/sh
''':'
# Python runs this file; these lines find it. A packaged toolchain brings
# its own (libexec/python); a checkout uses python3 from the PATH.
case $0 in */*) d=${0%/*} ;; *) d=. ;; esac
[ -x "$d/../libexec/python/bin/python3" ] && exec "$d/../libexec/python/bin/python3" "$0" "$@"
[ -x "$d/../libexec/python/python.exe" ] && exec "$d/../libexec/python/python.exe" "$0" "$@"
exec python3 "$0" "$@"
'''
__doc__ = """Build a PIC16F1 project: what `make` does in one, without make.

    pic16f1-build [build|clean|size|list|sim|debug|info] [options] [directory]

The directory (the current one if none is named) is a project as
pic16f1-new-project makes them, in C, C++, Rust, Zig or Forth, or an
Arduino sketch; which it is shows from what is in it (Cargo.toml, main.zig,
a .fth file, a .ino file, or C and C++ sources). The program is built to build/NAME.hex and build/NAME.elf with
debug information.

    build   (the default) compile and link; print the flash words used
    clean   remove what a build made
    size    the flash words the program takes
    list    its disassembly
    sim     build, then start the simulator waiting for a debugger
    debug   build, then debug on the simulator with LLDB in this terminal
    info    what would be built, as JSON (for editors): the language, the
            device, the name, and where the program will be

    --device NAME   the device (pic16f1937)
    --opt LEVEL     -munoptimized, -O1, -O2, -O3 or -Os
    --mode MODE     Zig's build mode (ReleaseSmall)
    --debugger      build for an in-circuit debugger on the part (-mdebugger)
    --name NAME     the program's name (the directory's)
    --f-cpu HZ      an Arduino sketch's oscillator frequency (16000000)
    --port N        the simulator's port for `sim` (3333)
    -- FLAGS        more options for the compiler

What is not given is taken from the project's Makefile, if it has one
(its DEVICE, OPT, MODE, NAME, CFLAGS and F_CPU), so that this and `make` build
the same program. It is for systems without make (Windows) and for editors: the
VS Code extension builds with it.
"""
import glob
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
# Programs are NAME.exe on Windows.
EXE = ".exe" if os.name == "nt" else ""
C_SOURCES = ("*.c", "*.cpp", "*.cc", "*.cxx", "*.S", "*.s")


def fail(message):
    sys.exit("pic16f1-build: " + message)


def tool(name):
    """A program of the toolchain: a script beside this one (run by the
    Python that runs this), or a compiled program here or in a checkout."""
    path = os.path.join(HERE, name)
    if name in ("pic16f1-cc", "pic16f1-zig", "pic16f1-forth", "pic16f1-rust-ld"):
        return [sys.executable, path]
    repo = os.path.normpath(os.path.join(HERE, "..", ".."))
    for c in (os.environ.get("PIC16F1_SIM") if name == "pic16f1-sim" else None,
              os.path.join(os.environ["PIC16F1_LLVM_BIN"], name + EXE) if os.environ.get("PIC16F1_LLVM_BIN") else None,
              path + EXE,
              os.path.join(repo, "sim", "target", "release", name + EXE) if name == "pic16f1-sim" else None,
              os.path.join(repo, "build", "llvm-build", "bin", name + EXE)):
        if c and os.path.exists(c):
            return [c]
    fail(f"cannot find {name}")


def makefile_values(directory):
    """NAME = value lines of the project's Makefile (any of =, :=, ?=)."""
    values = {}
    try:
        with open(os.path.join(directory, "Makefile"), encoding="utf-8") as f:
            for line in f:
                m = re.match(r"([A-Z_]+)\s*[:?]?=\s*(.*?)\s*$", line)
                if m and "$" not in m.group(2):
                    values.setdefault(m.group(1), m.group(2))
    except OSError:
        pass
    return values


def language_of(directory):
    if os.path.exists(os.path.join(directory, "Cargo.toml")):
        return "rust"
    if os.path.exists(os.path.join(directory, "main.zig")):
        return "zig"
    if glob.glob(os.path.join(directory, "*.fth")):
        return "forth"
    if glob.glob(os.path.join(directory, "*.ino")):
        return "arduino"
    return "c"


def run(cmd, **kw):
    try:
        r = subprocess.run(cmd, **kw)
    except FileNotFoundError:
        fail(f"cannot run {cmd[0]}: it is not installed, or not on the PATH")
    if r.returncode != 0:
        sys.exit(r.returncode if r.returncode > 0 else 1)
    return r


def sources(patterns):
    found = []
    for p in patterns:
        found += sorted(glob.glob(p))
    # (A file system that ignores case gives *.s and *.S the same files.)
    return list(dict.fromkeys(found))


def build_rust(o):
    rust = None
    for c in (os.path.join(HERE, "..", "share", "pic16f1", "rust"), os.path.join(HERE, "..", "rust")):
        if os.path.exists(os.path.join(c, "pic16f1.json")):
            rust = os.path.normpath(c)
            break
    if not rust:
        fail("cannot find the Rust target description (pic16f1.json)")
    link = [f"-mcpu={o.device}", o.opt or "-Os", "-g", "-mstack-report"] + (["-mdebugger"] if o.debugger else []) + o.extra
    env = dict(os.environ)
    # cargo runs the linker as a program: the launcher on Windows, the
    # script itself elsewhere.
    env["CARGO_TARGET_PIC16F1_LINKER"] = os.path.join(HERE, "pic16f1-rust-ld" + EXE)
    env["CARGO_TARGET_PIC16F1_RUSTFLAGS"] = " ".join(["-C", "linker-plugin-lto"] + [f"-C link-arg={a}" for a in link])
    run(["cargo", "build", "--release", "-Zbuild-std=core", "--target", os.path.join(rust, "pic16f1.json")], env=env)
    out = os.path.join("target", "pic16f1", "release")
    elf = os.path.join(out, o.name + ".elf")
    if not os.path.exists(elf):
        made = sorted(glob.glob(os.path.join(out, "*.elf")), key=os.path.getmtime)
        if not made:
            fail(f"cargo made no program in {out}")
        elf = made[-1]
    shutil.copyfile(elf, o.elf)
    notes = sorted(glob.glob(os.path.join(out, "deps", "*.link.txt")), key=os.path.getmtime)
    if notes:
        shutil.copyfile(notes[-1], os.path.join("build", o.name + ".link.txt"))
        with open(notes[-1], encoding="utf-8", errors="replace") as f:
            sys.stdout.write(f.read())
    run(tool("pic16f1-sim") + ["elf2hex", o.elf, o.hex])


# ---- Arduino sketches ---------------------------------------------------------
NOT_FUNCTIONS = {"if", "else", "while", "for", "switch", "return", "do", "class", "struct", "union", "enum",
                 "namespace", "typedef", "new", "delete", "operator", "using", "template", "case", "sizeof"}


def blanked(text):
    """The text with comments, strings and character constants turned to
    spaces (new lines kept), so that what is left is code and every
    character is where it was."""
    def spaces(m):
        return re.sub(r"[^\n]", " ", m.group(0))
    return re.sub(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\'', spaces, text, flags=re.S)


def sketch_functions(text):
    """(offset, prototype) of each function defined at the top level of a
    sketch, in order; no prototype for the ones <Arduino.h> declares."""
    code = blanked(text)
    found = []
    depth = 0
    starts = {m.start(): m for m in re.finditer(
        r"^[ \t]*((?:[A-Za-z_][\w:<>,\[\]]*[ \t*&]+)+)([A-Za-z_]\w*)[ \t]*\(([^(){};]*)\)[ \t\r\n]*\{", code, re.M)}
    for i, ch in enumerate(code):
        if depth == 0 and i in starts:
            m = starts[i]
            words = set(re.findall(r"[A-Za-z_]\w*", m.group(1))) | {m.group(2)}
            if not words & NOT_FUNCTIONS:
                # (A default argument is said once, where the function is;
                # setup and loop are declared by <Arduino.h>.)
                params = re.sub(r"\s*=[^,]*", "", " ".join(m.group(3).split()))
                proto = f"{' '.join(m.group(1).split())} {m.group(2)}({params});"
                found.append((i, None if m.group(2) in ("setup", "loop", "main") else proto))
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
    return found


def sketch_to_cpp(inos, out):
    """One C++ source from the .ino files of a sketch, as the Arduino IDE
    makes it: <Arduino.h> first, and every function declared before the
    first is defined, so that their order does not matter. #line keeps the
    compiler's messages pointing into the .ino files."""
    def quoted(path):
        return path.replace("\\", "/")
    texts = [(f, open(f, encoding="utf-8", errors="replace").read()) for f in inos]
    protos = [p for _, t in texts for _, p in sketch_functions(t) if p]
    first, text = texts[0]
    here = sketch_functions(text)
    at = here[0][0] if here else len(text)
    line = text.count("\n", 0, at) + 1
    parts = ["#include <Arduino.h>\n", f'#line 1 "{quoted(first)}"\n', text[:at]]
    parts += [p + "\n" for p in protos]
    parts += [f'#line {line} "{quoted(first)}"\n', text[at:], "\n"]
    for f, t in texts[1:]:
        parts += [f'#line 1 "{quoted(f)}"\n', t, "\n"]
    new = "".join(parts)
    try:
        if open(out, encoding="utf-8").read() == new:
            return
    except OSError:
        pass
    with open(out, "w", encoding="utf-8", newline="\n") as f:
        f.write(new)


def arduino_home():
    for c in (os.path.join(HERE, "..", "share", "pic16f1", "arduino"), os.path.join(HERE, "..", "arduino")):
        if os.path.exists(os.path.join(c, "cores", "pic16f1", "Arduino.h")):
            return os.path.normpath(c)
    fail("cannot find the Arduino core (cores/pic16f1/Arduino.h)")


def arduino_libraries(sources, places):
    """The libraries the sources include, and the ones those include: for
    #include <Name.h>, the first place with Name/src/Name.h or
    Name/Name.h."""
    used, seen, todo = [], set(), list(sources)
    while todo:
        src = todo.pop()
        try:
            text = open(src, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for header in re.findall(r'^\s*#\s*include\s*[<"]([^>"]+)[>"]', text, re.M):
            name = os.path.splitext(os.path.basename(header))[0]
            if name in seen:
                continue
            for place in places:
                for d in (os.path.join(place, name, "src"), os.path.join(place, name)):
                    if os.path.exists(os.path.join(d, os.path.basename(header))):
                        seen.add(name)
                        used.append(d)
                        todo += [os.path.join(d, f) for f in sorted(os.listdir(d))
                                 if f.endswith((".h", ".hpp", ".cpp", ".c"))]
                        break
                if name in seen:
                    break
    return used


def build_arduino(o):
    home = arduino_home()
    core = os.path.join(home, "cores", "pic16f1")
    variant = os.path.join(home, "variants", o.device)
    if not os.path.isdir(variant):
        have = ", ".join(sorted(os.listdir(os.path.join(home, "variants"))))
        fail(f"the Arduino core has no pins for the {o.device} (it has: {have})")
    # The sketch: NAME.ino first if there is one, as the directory is named.
    inos = sorted(glob.glob("*.ino"))
    main = os.path.basename(os.getcwd()) + ".ino"
    if main in inos:
        inos.remove(main)
        inos.insert(0, main)
    work = os.path.join("build", "arduino")
    os.makedirs(work, exist_ok=True)
    sketch = os.path.join(work, o.name + ".ino.cpp")
    sketch_to_cpp([os.path.abspath(f) for f in inos], sketch)
    more = sources(["*.cpp", "*.cc", "*.c", "*.S"])

    places = [os.path.abspath("libraries"), os.path.join(home, "libraries")]
    places += [p for p in os.environ.get("PIC16F1_ARDUINO_LIBRARIES", "").split(os.pathsep) if p]
    places.append(os.path.join(os.path.expanduser("~"), "Documents", "Arduino", "libraries"))
    libraries = arduino_libraries([os.path.abspath(f) for f in inos + more], [p for p in places if os.path.isdir(p)])

    common = [f"-mcpu={o.device}", o.opt or "-Os", "-g", f"-DF_CPU={o.f_cpu}UL", "-DARDUINO=10800",
              "-I", core, "-I", variant] + [x for d in libraries for x in ("-I", d)]
    common += (["-mdebugger"] if o.debugger else []) + o.extra
    flags = {True: ["-std=gnu++17"], False: ["-std=gnu11", "--libc"]}
    stamp = " ".join(common)

    def compiled(src, obj_dir, headers):
        """The object of a source, compiled if it is not up to date (the
        source, a header beside it, or the options changed)."""
        os.makedirs(obj_dir, exist_ok=True)
        obj = os.path.join(obj_dir, os.path.basename(src) + ".o")
        said = obj + ".flags"
        try:
            fresh = (open(said).read() == stamp and
                     os.path.getmtime(obj) >= max(os.path.getmtime(f) for f in [src] + headers))
        except OSError:
            fresh = False
        if not fresh:
            cxx = not src.endswith((".c", ".S"))
            run(tool("pic16f1-cc") + common + flags[cxx] + ["-flto", "-c", src, "-o", obj])
            with open(said, "w") as f:
                f.write(stamp)
        return obj

    def headers_of(*dirs):
        return [os.path.join(d, f) for d in dirs for f in os.listdir(d) if f.endswith((".h", ".hpp"))]

    # The core, as a library: the linker takes from it what the sketch
    # uses (the serial port's interrupt code only with Serial, and so on).
    core_headers = headers_of(core, variant)
    members = [compiled(os.path.join(core, f), os.path.join(work, "core"), core_headers)
               for f in sorted(os.listdir(core)) if f.endswith((".cpp", ".c"))]
    archive = os.path.join(work, "core.a")
    if not os.path.exists(archive) or any(os.path.getmtime(m) > os.path.getmtime(archive) for m in members):
        if os.path.exists(archive):
            os.remove(archive)
        run(tool("llvm-ar") + ["rcs", archive] + members)
    objects = []
    for n, d in enumerate(libraries):
        lib_headers = core_headers + headers_of(d)
        objects += [compiled(os.path.join(d, f), os.path.join(work, f"lib{n}-" + os.path.basename(os.path.dirname(d) if os.path.basename(d) == "src" else d)), lib_headers)
                    for f in sorted(os.listdir(d)) if f.endswith((".cpp", ".c"))]
    local = [os.path.abspath(f) for f in sources(["*.h", "*.hpp"])]
    objects += [compiled(os.path.abspath(f), os.path.join(work, "sketch"), core_headers + local) for f in more]
    run(tool("pic16f1-cc") + common + flags[True] + ["-I", os.getcwd(), "-o", o.hex, sketch] + objects + [archive])


def build(o):
    os.makedirs("build", exist_ok=True)
    flags = ["-g"] + ([o.opt] if o.opt else []) + [f"-mcpu={o.device}"] + (["-mdebugger"] if o.debugger else [])
    sys.stdout.flush()
    if o.language == "rust":
        build_rust(o)
    elif o.language == "zig":
        run(tool("pic16f1-zig") + ["-g", "-O", o.mode] + flags[1:] + o.extra + ["-o", o.hex, "main.zig"] + sources(["*.c"]))
    elif o.language == "arduino":
        build_arduino(o)
    elif o.language == "forth":
        main = "main.fth" if os.path.exists("main.fth") else sources(["*.fth"])[0]
        run(tool("pic16f1-forth") + flags + o.extra + ["-o", o.hex, main])
    else:
        found = sources(C_SOURCES)
        if not found:
            fail(f"no sources in {os.getcwd()} (C, C++ or assembly files, Cargo.toml, main.zig or a .fth file)")
        if not o.opt:
            flags.insert(1, "-O1")
        run(tool("pic16f1-cc") + flags + ["-Wall"] + o.extra + ["-o", o.hex] + found)
    size(o)


def size(o):
    r = run(tool("pic16f1-sim") + ["size", "--device", o.device, o.elf], capture_output=True, text=True)
    print(f"{r.stdout.strip()} words of flash used")
    sys.stdout.flush()


class Options:
    pass


def main():
    args = sys.argv[1:]
    o = Options()
    o.device = o.opt = o.mode = o.name = o.f_cpu = None
    o.debugger = False
    o.extra = []
    port = "3333"
    command, directory = None, None
    while args:
        a = args.pop(0)
        if a in ("-h", "--help"):
            print(__doc__)
            return 0
        if a == "--":
            o.extra = args
            break
        if a in ("--device", "--opt", "--mode", "--name", "--port", "--f-cpu") and args:
            value = args.pop(0)
            if a == "--port":
                port = value
            else:
                setattr(o, a[2:].replace("-", "_"), value)
        elif a == "--debugger":
            o.debugger = True
        elif a in ("build", "clean", "size", "list", "sim", "debug", "info") and command is None and directory is None:
            command = a
        elif a.startswith("-") or directory is not None:
            fail(f"unexpected argument {a}; see --help")
        else:
            directory = a
    command = command or "build"
    directory = os.path.abspath(directory or ".")
    if not os.path.isdir(directory):
        fail(f"no directory {directory}")
    os.chdir(directory)

    made = makefile_values(directory)
    o.language = language_of(directory)
    o.device = (o.device or made.get("DEVICE") or "pic16f1937").lower()
    if not o.device.startswith("pic"):
        o.device = "pic" + o.device
    o.opt = o.opt or made.get("OPT")
    o.mode = o.mode or made.get("MODE") or "ReleaseSmall"
    o.f_cpu = re.sub(r"[UuLl]+$", "", o.f_cpu or made.get("F_CPU") or "16000000")
    o.name = o.name or made.get("NAME") or re.sub(r"[^A-Za-z0-9_-]", "-", os.path.basename(directory)) or "program"
    if made.get("CFLAGS") and o.language != "rust":
        import shlex
        o.extra = shlex.split(made["CFLAGS"]) + o.extra
    o.hex = os.path.join("build", o.name + ".hex")
    o.elf = os.path.join("build", o.name + ".elf")

    if command == "info":
        import json
        print(json.dumps({"directory": directory, "language": o.language, "device": o.device, "name": o.name,
                          "optimization": o.opt or ("-Os" if o.language in ("rust", "arduino") else "" if o.language == "zig" else "-O1"),
                          "hex": os.path.join(directory, o.hex), "elf": os.path.join(directory, o.elf)}))
        return 0
    if command == "clean":
        for d in ("build", "target") if o.language == "rust" else ("build",):
            shutil.rmtree(d, ignore_errors=True)
        return 0
    if command in ("size", "list"):
        if not os.path.exists(o.elf):
            fail(f"no {o.elf}; build first")
        if command == "size":
            size(o)
        else:
            run(tool("pic16f1-sim") + ["disasm", "--device", o.device, o.elf])
        return 0
    build(o)
    if command == "sim":
        return subprocess.run(tool("pic16f1-sim") + ["gdb", "--device", o.device, "--port", port, o.elf]).returncode
    if command == "debug":
        sim = subprocess.Popen(tool("pic16f1-sim") + ["gdb", "--device", o.device, "--port", port, o.elf])
        try:
            import time
            time.sleep(0.3)
            return subprocess.run(tool("lldb") + ["-O", "settings set target.process.memory-cache-line-size 32", o.elf,
                                                  "-o", f"gdb-remote {port}",
                                                  "-o", "breakpoint set --one-shot true --name main",
                                                  "-o", "continue"]).returncode
        finally:
            sim.terminate()
    return 0


if __name__ == "__main__":
    sys.exit(main())
