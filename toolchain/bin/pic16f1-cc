#!/usr/bin/env python3
"""Compiler driver for the PIC16F1 LLVM toolchain.

    pic16f1-cc -mcpu=pic16f1937 -Os -o prog.hex main.c other.c

Compiles C and assembly sources with clang, links them with ld.lld against
the startup code and runtime library, and converts the result to Intel HEX.
With -o NAME.hex it also leaves NAME.elf beside it; any other -o name gets
the ELF file. -c and -S stop after compiling.

-mcmodel=small leaves out the page selection (MOVLP) before calls, which is
right only for a program that fits in the first 2K words of flash; the
linker checks. -mcmodel=medium always selects the page. When this driver
compiles and links in one step and no model is given, it tries small first
and falls back to medium if the program turns out too big. With -c or -S
the default is medium.

A build that compiles and links in one step is compiled as a whole program
(-flto): the compiler sees every call, so it can inline across files, turn
calls through constant function pointers into direct calls, give every
function that is not re-entered a static frame, and leave out what the
program does not use. -fno-lto compiles each file on its own. With -c or -S
the default is file by file; give -flto to make objects for a whole-program
link.

-O3 means "small, and nothing that costs time": clang's -Os without the
sharing of repeated sequences, which saves words at the price of a call each
time one runs. (Clang's own -O3 spends words on speed that this processor
does not have.)

--libc compiles and links against picolibc (stdio, string, stdlib, math),
if it has been built (scripts/build-picolibc.sh). The program must supply
`stdout` for printf; see docs/toolchain.md.

The linker counts the levels of the hardware return stack that the deepest
chain of calls takes, and warns if they are more than the part's 16.
-mstack-report prints the count and the chain.

-mdebugger builds for an in-circuit debugger on the part itself: the
program keeps out of the RAM the debugger uses and may not name the two port
pins that are its clock and data lines (it also defines __DEBUG, as XC8
does). Use it with -g. The simulator needs neither.

Tool locations can be overridden with PIC16F1_LLVM_BIN (clang, ld.lld),
PIC16F1_LIB (crt0.o, libpicrt.a, linker scripts), PIC16F1_INCLUDE,
PIC16F1_LIBC (picolibc's install directory) and PIC16F1_SIM (pic16f1-sim,
used for the HEX conversion).
"""
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))


def first_existing(candidates, what):
    for c in candidates:
        if c and os.path.exists(c):
            return c
    sys.exit(f"pic16f1-cc: cannot find {what}; tried:\n  " + "\n  ".join(c for c in candidates if c))


def locate():
    repo = os.path.normpath(os.path.join(HERE, "..", ".."))
    llvm_bin = first_existing([
        os.environ.get("PIC16F1_LLVM_BIN"),
        HERE if os.path.exists(os.path.join(HERE, "clang")) else None,
        os.path.join(repo, "build", "llvm-build", "bin"),
    ], "the LLVM tools (clang, ld.lld)")
    lib = first_existing([
        os.environ.get("PIC16F1_LIB"),
        os.path.join(HERE, "..", "lib", "pic16f1"),
        os.path.join(repo, "build", "toolchain", "lib", "pic16f1"),
    ], "the runtime library directory")
    inc = first_existing([
        os.environ.get("PIC16F1_INCLUDE"),
        os.path.join(HERE, "..", "include", "pic16f1"),
        os.path.join(HERE, "..", "include"),
    ], "the device header directory")
    sim = first_existing([
        os.environ.get("PIC16F1_SIM"),
        os.path.join(HERE, "pic16f1-sim"),
        os.path.join(repo, "sim", "target", "release", "pic16f1-sim"),
        shutil.which("pic16f1-sim"),
    ], "pic16f1-sim")
    return llvm_bin, lib, inc, sim


def run(cmd):
    r = subprocess.run(cmd)
    if r.returncode < 0:
        sys.exit(f"pic16f1-cc: {os.path.basename(cmd[0])} killed by signal {-r.returncode}")
    if r.returncode != 0:
        sys.exit(r.returncode)


def main():
    args = sys.argv[1:]
    if not args or "--help" in args or "-h" in args:
        print(__doc__)
        return 0
    llvm_bin, lib, inc, sim = locate()

    output = None
    cpu = "pic16f1937"
    compile_only = asm_only = use_libc = unoptimized = debugger = False
    model = None
    sources, objects, cflags, ldflags = [], [], [], []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-o":
            output = args[i + 1]
            i += 1
        elif a.startswith("-mcpu="):
            cpu = a[len("-mcpu="):].lower()
        elif a == "-c":
            compile_only = True
        elif a == "-S":
            asm_only = True
        elif a.startswith("-mcmodel="):
            model = a[len("-mcmodel="):]
            if model not in ("small", "medium"):
                sys.exit("pic16f1-cc: -mcmodel must be small or medium")
        elif a == "-munoptimized":
            unoptimized = True
        elif a == "-mdebugger":
            debugger = True
        elif a == "-mstack-report":
            ldflags += ["-z", "pic16f1-stack-report"]
        elif a == "-minterrupt-copies":
            ldflags += ["-z", "pic16f1-interrupt-copies"]
        elif a == "-mmain-saves-registers":
            cflags += ["-mllvm", "-pic16f1-main-saves-registers"]
        elif a == "--libc":
            use_libc = True
        elif a.startswith("-Wl,"):
            ldflags += a[4:].split(",")
        elif a.endswith((".c", ".S", ".s", ".ll")):
            sources.append(a)
        elif a.endswith((".o", ".a")):
            objects.append(a)
        else:
            cflags.append(a)
        i += 1
    if not cpu.startswith("pic"):
        cpu = "pic" + cpu
    if not sources and not objects:
        sys.exit("pic16f1-cc: no input files")

    clang = [os.path.join(llvm_bin, "clang"), "--target=pic16f1", f"-mcpu={cpu}",
             "-ffunction-sections", "-fdata-sections",
             # A #pragma the compiler does not know is otherwise ignored
             # without a word.
             "-Wunknown-pragmas"]
    libs = [os.path.join(lib, "libpicrt.a")]
    if debugger:
        # The linker script says what the debugger needs kept clear, for the
        # devices whose data gives it.
        ld = os.path.join(lib, cpu + ".ld")
        if not os.path.exists(ld) or "__debugger" not in open(ld).read():
            sys.exit(f"pic16f1-cc: -mdebugger: it is not known what a debugger uses on the {cpu}")
        clang += ["-D__DEBUG=1"]
        ldflags += ["--defsym=__debugger=1"]
    if use_libc:
        repo = os.path.normpath(os.path.join(HERE, "..", ".."))
        candidates = [os.environ.get("PIC16F1_LIBC"),
                      os.path.join(HERE, "..", "picolibc"),
                      os.path.join(repo, "build", "toolchain", "picolibc")]
        # The linker script says whether the device has 32 or 64 banks; the
        # library is built separately for each.
        variant = "banks32"
        ld = os.path.join(lib, cpu + ".ld")
        if os.path.exists(ld) and "Library variant: banks64" in open(ld).read():
            variant = "banks64"
        candidates = [os.path.join(c, variant) for c in candidates if c]
        libc = first_existing(
            [c for c in candidates if os.path.exists(os.path.join(c, "lib", "libc.a"))]
            or candidates, "picolibc (run scripts/build-picolibc.sh)")
        clang += ["-isystem", os.path.join(libc, "include")]
        # libc calls the runtime library and the runtime's float code is
        # independent of libc, so libc goes first.
        libs = [os.path.join(libc, "lib", "libc.a")] + libs
    else:
        clang += ["-ffreestanding"]
    # The level is the last -O option; without one it is -O0. See the
    # header for what -O0 means here.
    levels = [f for f in cflags if f.startswith("-O")]
    level = levels[-1] if levels else "-O0"
    if level == "-O0":
        cflags = [f for f in cflags if not f.startswith("-O")]
        cflags += ["-O0"] if unoptimized else ["-O1", "-fno-inline"]
    elif level == "-O3":
        cflags = [f for f in cflags if not f.startswith("-O")]
        cflags += ["-Os"] + ([] if "-moutline" in cflags else ["-mno-outline"])
    clang += ["-isystem", inc] + cflags
    # LLVM's defaults assume a machine where a call costs several
    # instructions, a function of ten or so is small, and memory is there to
    # be spent on speed. Here a call is one or two words and flash is a few
    # thousand, so at every level:
    #   - less is inlined (a function with a single caller still always is);
    #   - loops are not unrolled (-funroll-loops turns that back on), except
    #     at -Os and -Oz, where LLVM only unrolls a loop that gets smaller;
    #   - a bitwise CRC loop is not replaced by a 256-entry table.
    #   - a loop that fills or copies memory is not replaced by a call to
    #     memset or memcpy: the loop, with its pointer in an FSR, is faster
    #     than the general routine and usually smaller than setting up the
    #     call.
    tuning = []
    if not any("inline-threshold" in f for f in cflags):
        tuning += ["-mllvm", "-inline-threshold=10", "-mllvm", "-inline-call-penalty=5"]
    tuning += ["-mllvm", "-disable-loop-idiom-hashrecognize"]
    tuning += ["-mllvm", "-disable-loop-idiom-memset", "-mllvm", "-disable-loop-idiom-memcpy"]
    size_level = any(f in ("-Os", "-Oz") for f in cflags)
    unroll = [] if size_level or "-funroll-loops" in cflags else ["-fno-unroll-loops"]
    clang += unroll
    clang += tuning
    # A build that compiles and links in one step sees the whole program, and
    # is compiled as one (-flto) unless -fno-lto says otherwise. With -c or
    # -S only if asked. The linker then generates the code and needs the
    # same options.
    asked = any(f == "-flto" or f.startswith("-flto=") for f in cflags)
    lto = asked or not (compile_only or asm_only or "-fno-lto" in cflags)
    if lto and not asked:
        clang += ["-flto"]
    link_tuning = list(tuning)
    if unroll:
        link_tuning += ["-mllvm", "-unroll-threshold=0",
                        "-mllvm", "-unroll-partial-threshold=0"]

    if compile_only or asm_only:
        cmd = clang + [f"-mcmodel={model or 'medium'}", "-S" if asm_only else "-c"] + sources
        if output:
            cmd += ["-o", output]
        run(cmd)
        return 0

    script = os.path.join(lib, cpu + ".ld")
    if not os.path.exists(script):
        sys.exit(f"pic16f1-cc: no linker script for {cpu} ({script})")

    output = output or "a.hex"
    want_hex = output.endswith(".hex")
    elf = output[:-4] + ".elf" if want_hex else output

    def build(model, quiet):
        """Compile and link for one code model; False if that fails."""
        small = model == "small"
        with tempfile.TemporaryDirectory() as tmp:
            objs = []
            for n, src in enumerate(sources):
                obj = os.path.join(tmp, f"{n}-{os.path.splitext(os.path.basename(src))[0]}.o")
                run(clang + [f"-mcmodel={model}"] + (["-DONE_PAGE"] if small and src.endswith(".S") else [])
                    + ["-c", src, "-o", obj])
                objs.append(obj)
            # The runtime library exists for each model. picolibc is built
            # for medium only, which is also correct in a small program.
            rt = [l.replace("libpicrt.a", "libpicrt-small.a") if small else l for l in libs]
            crt0 = os.path.join(lib, "crt0-small.o" if small else "crt0.o")
            # Debug information about code the linker left out (the versions
            # of a function it did not choose, among others) gets an address
            # no code has, where the default, 0, is the reset vector.
            table = os.path.join(lib, cpu + ".cfg")
            link = [os.path.join(llvm_bin, "ld.lld"), "-T", script, "--gc-sections",
                    "-z", "dead-reloc-in-nonalloc=.debug_*=0xffffffff",
                    crt0] + objs + objects + rt + ["-o", elf] + ldflags
            # What the settings of #pragma config mean on this device.
            if os.path.exists(table):
                link += ["-z", "pic16f1-config=" + table]
            if lto:
                link += ["-mllvm", f"-code-model={model}",
                         f"-plugin-opt=mcpu={cpu}"] + link_tuning
                # -munoptimized means it for the whole program too: the
                # linker's optimizer would otherwise still fold away
                # variables a debugger is asked for.
                if unoptimized:
                    link += ["--lto-O0"]
            if quiet:
                # Say nothing of a failure (the caller tries the other
                # model), but pass on what a successful link had to say.
                r = subprocess.run(link, capture_output=True)
                if r.returncode == 0:
                    sys.stdout.buffer.write(r.stdout)
                    sys.stderr.buffer.write(r.stderr)
                    sys.stdout.flush()
                    sys.stderr.flush()
                return r.returncode == 0
            run(link)
            return True

    have_small = os.path.exists(os.path.join(lib, "libpicrt-small.a"))
    if model == "small" or (model is None and have_small and not use_libc):
        # Without an explicit model, a program too big for one page is
        # simply built again for medium.
        if not build("small", quiet=model is None):
            build("medium", quiet=False)
    else:
        build("medium", quiet=False)
    if want_hex:
        run([sim, "elf2hex", elf, output])
    return 0


if __name__ == "__main__":
    sys.exit(main())
