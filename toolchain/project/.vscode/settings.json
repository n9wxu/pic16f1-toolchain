{
    // The device, and how the program is optimized (-munoptimized, -O1,
    // -O2, -O3 or -Os). The PIC16F1 Toolchain extension reads these; the
    // status bar shows them, and a click there changes the device.
    "pic16f1.device": "@DEVICE@",
    "pic16f1.optimization": "-O1",
    // For debugging on the part itself: the OpenOCD of the PICkit 2 probe
    // firmware (its build directory, which has src/openocd and tcl/), and
    // the target's supply in millivolts.
    "pic16f1.openocd": "@OPENOCD@",
    "pic16f1.vdd": "3300",
    // Let the MEMORY view of the Memory View extension follow these
    // debug sessions.
    "memory-view.trackDebuggers": [ "pic16f1" ],
    "files.associations": { "*.h": "c" },
    "C_Cpp.errorSquiggles": "disabled"
}
