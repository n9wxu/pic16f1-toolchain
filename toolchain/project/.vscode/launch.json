{
    // Needs the "PIC16F1 Toolchain" extension, which builds the project,
    // starts the simulator (or OpenOCD for the probe) and debugs with the
    // toolchain's own LLDB.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug on the simulator",
            "type": "pic16f1",
            "request": "launch",
            "target": "simulator"
        },
        {
            // Programs the part through a probe's OpenOCD and debugs it
            // there (the pic16f1.openocd setting says where that is). The
            // part has one breakpoint; see the README.
            "name": "Debug on the part (probe)",
            "type": "pic16f1",
            "request": "launch",
            "target": "probe"
        }
    ]
}
